[Unit]
Description=Pars grant-gated Epoptes broker
After=epoptes.service
Requires=epoptes.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m pars_admin.broker.main --admin-pubkey-file /var/lib/pars-admin/trust_root.pub --epoptesd-socket /run/epoptes/epoptes.socket
Restart=on-failure
RestartSec=10
User=pars-broker
Group=epoptes

[Install]
WantedBy=multi-user.target
